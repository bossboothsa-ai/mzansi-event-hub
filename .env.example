# =============================================================================
# Mzansi Event Hub (Out There ZA) - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit the real .env file to version control.
# =============================================================================

# --- Database ---
# PostgreSQL connection string.
# Local:  postgresql://postgres@127.0.0.1:5432/mzansi_events
# Render: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/mzansi_events

# --- Session Security ---
# Secret used to sign session cookies. Must be at least 32 characters.
# Generate a secure one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In production, set this to a long random string and keep it secret.
SESSION_SECRET=dev-secret-change-me-minimum-32-characters-long

# --- Admin Bootstrap ---
# Token required to create the first admin account via POST /api/auth/bootstrap-admin.
# Must be at least 32 characters. After the first admin is created, this endpoint
# is disabled (returns 410). Keep this secret and only share it with the person
# setting up the admin account.
ADMIN_BOOTSTRAP_TOKEN=dev-admin-bootstrap-token-change-me

# --- PayFast (Payment Gateway) ---
# Secret used to encrypt/decrypt organiser PayFast credentials (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This must match the value used when the organiser's PayFast settings were encrypted.
PAYFAST_ENCRYPTION_SECRET=dev-payfast-encryption-secret-change-me

# Public URL that PayFast calls back (ITN - Instant Transaction Notification) after payment.
# Local:  http://localhost:8001/api/payments/payfast/itn
# Render: https://your-api.onrender.com/api/payments/payfast/itn
# This MUST be a public HTTPS URL in production. PayFast cannot reach localhost.
PAYFAST_NOTIFY_URL=http://localhost:8001/api/payments/payfast/itn

# --- Email (Resend) ---
# Resend API key from https://resend.com (free tier: 3,000 emails/month, 100/day).
# Without a verified domain, Resend only delivers to your account email from @resend.dev.
RESEND_API_KEY=

# The "from" address for all outgoing emails.
# Without a domain: Out There ZA <onboarding@resend.dev>
# With a verified domain: Out There ZA <tickets@yourdomain.co.za>
EMAIL_FROM=Out There ZA <onboarding@resend.dev>

# --- Frontend / CORS ---
# The public URL of the frontend (used for CORS, email links, and PayFast redirects).
# Local:  http://localhost:8000
# Render: https://your-frontend.onrender.com
WEB_ORIGIN=http://localhost:8000

# --- Server ---
# Port the API server listens on.
# Local:  8001
# Render: 10000 (Render sets this automatically via the PORT env var)
PORT=8001

# --- Runtime ---
# Set to "production" in production. Enables secure cookies and stricter CORS.
# NODE_ENV=production

# --- File Storage (Private Documents) ---
# Directory where uploaded verification documents are stored.
# Defaults to ./private-documents relative to the API server working directory.
# On Render, use a persistent disk path.
# PRIVATE_DOCUMENTS_DIR=/var/data/private-documents