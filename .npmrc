# CI / Render build settings.
# Note: engine-strict is intentionally NOT set, so a Node minor-version
# mismatch (e.g. Render picking Node 22 vs local 24) warns instead of failing
# the install. The app runs on Node 20.6+ (uses --env-file-if-exists).
# Keep logs clean and non-interactive in managed build environments.
fund=false
audit=false
progress=false